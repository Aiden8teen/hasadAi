# Hassad AI (حصاد) — Environment Configuration Template
# Duplicate this file to .env and provide your API keys

# Google Gemini API Key (required for Stage 4 LangGraph Advisory Agent)
# Get a free key at https://aistudio.google.com/
GOOGLE_API_KEY=your_gemini_api_key_here

# Agronomy LLM Model
GEMINI_MODEL=gemini-2.5-flash

# Default Region & Locale
DEFAULT_REGION_CODE=DZ-42
DEFAULT_LOCALE=en
